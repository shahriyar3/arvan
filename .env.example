# Application
APP_NAME=sms-gateway
APP_ENVIRONMENT=development
APP_LOG_LEVEL=info

# HTTP API
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s

# PostgreSQL (primary + optional read replica)
DATABASE_PRIMARY_DSN=postgres://sms:sms@localhost:5433/sms_gateway?sslmode=disable
DATABASE_REPLICA_DSN=

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_URL=amqp://sms:sms@localhost:5672/

# Outbox relay
OUTBOX_RELAY_POLL_INTERVAL=500ms
OUTBOX_RELAY_BATCH_SIZE=50
OUTBOX_RELAY_LOCK_DURATION=30s
OUTBOX_RELAY_SHUTDOWN_TIMEOUT=15s

# Worker
WORKER_PREFETCH_COUNT=10
WORKER_SHUTDOWN_TIMEOUT=30s

# Mock operator (HTTP adapter target)
OPERATOR_BASE_URL=http://localhost:8090
OPERATOR_TIMEOUT=10s

# Mock operator server (cmd/mock-operator)
MOCK_OPERATOR_HOST=0.0.0.0
MOCK_OPERATOR_PORT=8090
MOCK_OPERATOR_MIN_LATENCY=10ms
MOCK_OPERATOR_MAX_LATENCY=50ms
MOCK_OPERATOR_FAILURE_RATE=0

# Migrations (used by Makefile)
MIGRATE_DATABASE_URL=postgres://sms:sms@localhost:5433/sms_gateway?sslmode=disable
